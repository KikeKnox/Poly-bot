# poly-bot environment file. Copy to .env and fill in what you need.
# .env is git-ignored: NEVER commit it, and never paste real values into this example.
#
# Paper mode needs none of the secrets below, except POLY_API_KEY/SECRET/PASSPHRASE
# for the arb_15m5m strategy (it needs them to read the Chainlink TWAP feed).
#
# Besides the variables below, any configuration key can be overridden with an
# HRF_-prefixed variable; "__" separates nesting levels. See docs/CONFIGURATION.md:
#   HRF_MODE=paper                              -> mode (top level of config/general.toml)
#   HRF_API__TOKEN=xxx                          -> [api] token
#   HRF_RISK__MAX_TOTAL_EXPOSURE_USDC=20        -> [risk] max_total_exposure_usdc
#   HRF_ARB__ENABLED=true                       -> [arb] enabled (config/strategies/arb.toml)

# ── Operating mode ────────────────────────────────────────────────────────────
# paper (default in config/general.toml) | live
# ./launch.sh forces paper unless you pass --live. Live is refused at startup if
# this value contradicts `mode` in config/general.toml. In live a strategy runs
# only if it is `enabled` and not `paper_only`.
# HRF_MODE=paper

# ── Wallet (live only) ────────────────────────────────────────────────────────
# Private key of the wallet (64 hex characters, with or without 0x prefix).
POLY_PRIVATE_KEY=

# Signature type: 0 = EOA (default) | 1 = Proxy | 2 = GnosisSafe | 3 = Poly1271
# POLY_SIGNATURE_TYPE=0
# Funder address; only for signature types 1 and 2.
# POLY_PROXY_ADDRESS=

# ── CLOB API credentials ─────────────────────────────────────────────────────
# Polymarket CLOB L2 credentials. In live mode, if they are missing they are
# derived from the wallet and written back into this file for the next startup.
# In paper mode they are only used by the arb_15m5m strategy (TWAP feed).
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ── Local HTTP API ───────────────────────────────────────────────────────────
# Bearer token for the API and UI. Required when api.bind is not loopback;
# with an empty token in live mode the control endpoints answer 503.
# Generate one with: openssl rand -base64 32
# HRF_API__TOKEN=
# HRF_API__PORT=8766

# ── Telegram control (optional) ──────────────────────────────────────────────
# Started only if TELEGRAM_BOT_TOKEN is set. Behavior settings
# (fill_alerts, periodic_summary_hours) live in config/telegram.toml.
# Bot token from @BotFather; empty = Telegram disabled.
TELEGRAM_BOT_TOKEN=
# Telegram user IDs allowed to control the bot, comma-separated (e.g. 111,222).
TELEGRAM_ALLOWED_IDS=

# ── Logging and misc ─────────────────────────────────────────────────────────
# Log filter (tracing EnvFilter syntax). Default: info
# RUST_LOG=info
# Set to json for structured logs.
# LOG_FORMAT=json
# Directory of the built web UI (default: src/api/static/dist).
# HRF_UI_DIST_DIR=
# Set to 1 to skip loading this file entirely.
# HRF_NO_DOTENV=1
